@startuml
skinparam backgroundColor white
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam shadowing false
skinparam ArrowColor #345570
skinparam classBackgroundColor #F1F5F8
skinparam classBorderColor #173B62
skinparam classHeaderBackgroundColor #DCE7EF
skinparam entityBackgroundColor #F1F5F8
skinparam entityBorderColor #173B62
skinparam usecaseBackgroundColor #F6F1E6
skinparam usecaseBorderColor #AD9058
skinparam actorBorderColor #173B62
skinparam stateBackgroundColor #F1F5F8
skinparam stateBorderColor #173B62
actor Lector
participant "PrestamoController" as C
participant "PrestamoService" as S
participant "Repositorios JPA" as R
database MariaDB as DB
Lector -> C : POST /prestamos/solicitar + CSRF
C -> C : Validar formulario
C -> S : solicitar(datos)
activate S
S -> R : buscar y bloquear ejemplar
R -> DB : SELECT ... FOR UPDATE
DB --> R : ejemplar
R --> S : Libro
S -> R : consultar préstamo activo e incidencia
R -> DB : SELECT ...
DB --> R : disponibilidad
R --> S : resultado
alt ejemplar disponible y datos válidos
 S -> R : guardar lector, préstamo e historial
 R -> DB : INSERT ... en una transacción
 DB --> R : registros persistidos
 R --> S : préstamo SOLICITADO
 S --> C : Prestamo
 C --> Lector : Redirección y mensaje de solicitud
else ejemplar ocupado o datos incompatibles
 S --> C : ReglaNegocioException (409)
 C --> Lector : Mensaje de validación
end
deactivate S

@enduml
